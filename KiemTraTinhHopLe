import java.util.Scanner;

public class KiemTraTamGiac {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("--- CHƯƠNG TRÌNH KIỂM TRA TAM GIÁC ---");
        
        try {
            System.out.print("Nhập cạnh thứ nhất (a): ");
            int a = scanner.nextInt();
            
            System.out.print("Nhập cạnh thứ hai (b): ");
            int b = scanner.nextInt();
            
            System.out.print("Nhập cạnh thứ ba (c): ");
            int c = scanner.nextInt();

            if (a <= 0 || b <= 0 || c <= 0) {
                System.out.println("Lỗi: Các cạnh của tam giác phải là số nguyên dương lớn hơn 0.");
            } else {
                if ((a + b > c) && (a + c > b) && (b + c > a)) {
                    
                    if (a == b && b == c) {
                        System.out.println("Kết quả: Đây là tam giác đều.");
                    } 
                    else if (a == b || a == c || b == c) {
                        System.out.println("Kết quả: Đây là tam giác cân.");
                    } 
                    else if ((a * a + b * b == c * c) || (a * a + c * c == b * b) || (b * b + c * c == a * a)) {
                        System.out.println("Kết quả: Đây là tam giác vuông.");
                    } 
                    else {
                        System.out.println("Kết quả: Đây là tam giác thường.");
                    }
                    
                } else {
                    System.out.println("Ba cạnh không tạo thành tam giác.");
                }
            }
        } catch (Exception e) {
            System.out.println("Lỗi: Vui lòng chỉ nhập số nguyên hợp lệ!");
        }

        scanner.close();
    }
}
